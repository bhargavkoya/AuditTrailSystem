{
  "Urls": "http://localhost:5000",
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" } },
  "AllowedHosts": "*",
  "AuditFlow": { "Telemetry": { "Console": false } },
  "Cors": { "Origins": [ "http://localhost:5173" ] },
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "auth", "Match": { "Path": "/auth/{**rest}" } },
      "wellknown": { "ClusterId": "auth", "Match": { "Path": "/.well-known/{**rest}" } },
      "attachments": { "ClusterId": "attachment", "Order": 1, "Match": { "Path": "/engagements/{id}/attachments/{**rest}" } },
      "attachments-tab": { "ClusterId": "attachment", "Order": 1, "Match": { "Path": "/engagements/{id}/tabs/{tabNo}/attachments" } },
      "attachments-section": { "ClusterId": "attachment", "Order": 1, "Match": { "Path": "/engagements/{id}/sections/{sectionKey}/attachments" } },
      "workflow-tabs": { "ClusterId": "workflow", "Order": 2, "Match": { "Path": "/engagements/{id}/tabs/{**rest}" } },
      "workflow-sections": { "ClusterId": "workflow", "Order": 2, "Match": { "Path": "/engagements/{id}/sections/{sectionKey}" } },
      "workflow-validation": { "ClusterId": "workflow", "Order": 2, "Match": { "Path": "/engagements/{id}/validation-summary" } },
      "engagements": { "ClusterId": "engagement", "Order": 10, "Match": { "Path": "/engagements/{**rest}" } },
      "health-auth": { "ClusterId": "auth", "Match": { "Path": "/health/auth" }, "Transforms": [ { "PathSet": "/health" } ] },
      "health-engagement": { "ClusterId": "engagement", "Match": { "Path": "/health/engagement" }, "Transforms": [ { "PathSet": "/health" } ] },
      "health-workflow": { "ClusterId": "workflow", "Match": { "Path": "/health/workflow" }, "Transforms": [ { "PathSet": "/health" } ] },
      "health-attachment": { "ClusterId": "attachment", "Match": { "Path": "/health/attachment" }, "Transforms": [ { "PathSet": "/health" } ] },
      "health-review": { "ClusterId": "review", "Match": { "Path": "/health/review" }, "Transforms": [ { "PathSet": "/health" } ] },
      "health-notification": { "ClusterId": "notification", "Match": { "Path": "/health/notification" }, "Transforms": [ { "PathSet": "/health" } ] }
    },
    "Clusters": {
      "auth": { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "engagement": { "Destinations": { "d1": { "Address": "http://localhost:5002/" } } },
      "workflow": { "Destinations": { "d1": { "Address": "http://localhost:5003/" } } },
      "attachment": { "Destinations": { "d1": { "Address": "http://localhost:5004/" } } },
      "review": { "Destinations": { "d1": { "Address": "http://localhost:5005/" } } },
      "notification": { "Destinations": { "d1": { "Address": "http://localhost:5006/" } } }
    }
  }
}


